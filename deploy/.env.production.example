# Sao chép thành deploy/.env.production trên VPS rồi điền giá trị thật. KHÔNG commit file đã điền.
APP_ENV=production
APP_URL=https://aicampustour.suai.vn

# Database (dùng cho cả service db và chuỗi kết nối của app)
POSTGRES_USER=portal
POSTGRES_PASSWORD=
POSTGRES_DB=portal

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Email qua Brevo, gửi từ no-reply@suai.vn
EMAIL_TRANSPORT=brevo
EMAIL_FROM=no-reply@suai.vn
EMAIL_FROM_NAME=AI Campus Tour
BREVO_API_KEY=

# Google OAuth (redirect URI: https://aicampustour.suai.vn/api/auth/callback/google)
GOOGLE_CLIENT_ID=705269152037-o8p3trjn8bamc70au0cge35lihqp0gkp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Lưu file minh chứng trên Google Drive (Super Admin bấm "Kết nối Google Drive" ở /admin/luu-tru sau khi deploy).
# Cần thêm Redirect URI https://aicampustour.suai.vn/api/admin/drive/callback vào OAuth client.
STORAGE_DRIVER=drive
GOOGLE_DRIVE_ROOT_FOLDER=AI Campus Tour

# (Tùy chọn) Gửi sự kiện thông báo sang n8n để nhắn Zalo. Để trống nếu chỉ dùng email.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
