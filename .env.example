# Sao chép thành .env.local (dev) hoặc đặt trên VPS (production). Không commit file .env thật.
# development | staging | production (chỉ đặt production trên VPS chính thức)
APP_ENV=development
DATABASE_URL=postgres://portal:portal@localhost:5432/portal_dev
APP_URL=http://localhost:3000
# Database riêng cho test (tên phải chứa chữ "test")
DATABASE_URL_TEST=postgres://portal:portal@localhost:5432/portal_test
# Secret ký phiên đăng nhập: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Gửi email: file (dev, lưu thư vào EMAIL_OUTBOX_DIR) | brevo (production)
EMAIL_TRANSPORT=file
EMAIL_OUTBOX_DIR=.outbox
EMAIL_FROM=no-reply@suai.vn
EMAIL_FROM_NAME=AI Campus Tour
BREVO_API_KEY=
# Đăng nhập Google (để trống thì ẩn nút Google). Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=705269152037-o8p3trjn8bamc70au0cge35lihqp0gkp.apps.googleusercontent.com
# Secret chỉ đặt trên VPS, không commit, không gửi qua chat
GOOGLE_CLIENT_SECRET=
# Lưu file: local (dev) | drive (production)
STORAGE_DRIVER=local
UPLOAD_DIR=.uploads
# (Tùy chọn) webhook n8n cho thông báo Zalo
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
